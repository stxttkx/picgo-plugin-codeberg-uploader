{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": false,
    "target": "es2017",
    "declaration": true,
    "outDir": "dist",
    "lib": [
      "es7",
      "es2015",
      "dom"
    ]
  },
  "exclude": [
    "./test",
    "dist",
    "node_modules"
  ]
}
